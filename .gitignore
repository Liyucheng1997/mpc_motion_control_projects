# --- 编译与安装目录 (这是最容易产生冲突的地方) ---
build/
install/
log/

# --- Python 缓存文件 ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.pylint.d/

# --- C++/CMake 临时文件 ---
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.swp
*.patch

# --- IDE 配置文件 ---
.vscode/
.idea/
.project
.settings/
.classpath

# --- 系统临时文件 ---
.DS_Store
Thumbs.db

# --- 库与执行文件 ---
*.so
*.a
*.la
*.o
*.objgit rm -r --cached .
